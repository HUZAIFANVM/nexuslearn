# ============================================================
# NexusLearn backend env vars — copy to .env and fill in
# ============================================================
# NEVER commit the real .env file (it's gitignored).
# In production, set these as environment variables on your host
# (DigitalOcean App Platform, Heroku, etc.) — not in a file.

# ---- Core ----
SECRET_KEY=                                  # 64+ random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- MongoDB (use Atlas SRV URI in production) ----
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=corporate_lms

# ---- LLM ----
GROQ_API_KEY=                                # https://console.groq.com/keys
HF_TOKEN=                                    # https://huggingface.co/settings/tokens

# ---- Vector DB ----
PINECONE_API_KEY=                            # https://app.pinecone.io
PINECONE_INDEX_NAME=nexuslearn

# ---- Email (SMTP for verification + password reset) ----
# Brevo / SendGrid / Mailgun free tier all work. Leave blank if DEV_MODE=true.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
MAIL_PORT=587
MAIL_SERVER=smtp.your-provider.com
MAIL_FROM_NAME=NexusLearn

# ---- Email verification settings ----
VERIFICATION_TOKEN_EXPIRE_HOURS=24
FRONTEND_URL=http://localhost:3000           # In prod: https://your-domain.com

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=                            # https://console.cloud.google.com/

# ---- Dev mode (MUST be false in production) ----
# When true, signups are auto-verified (no email sent). Convenient locally,
# CATASTROPHIC in production.
DEV_MODE=false

# ---- Super Admin (seeded once at startup if no super_admin row exists) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=                        # Strong password, NOT 'ChangeMe!...'
SUPER_ADMIN_NAME=Super Admin

# ---- CORS (comma-separated allowed origins) ----
# Leave blank for local dev (defaults to localhost:3000)
# In prod: CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=
